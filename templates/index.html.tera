<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>HLS Tube</title>
  <style>
    :root { color-scheme: light; }
    body { font-family: "Inter", system-ui, -apple-system, sans-serif; max-width: 1080px; margin: 24px auto; padding: 0 12px; background: #fafafa; }
    a { text-decoration: none; color: inherit; }
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
      align-items: start;
    }
    .card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 22px rgba(0,0,0,0.05);
      overflow: hidden;
      transition: transform 120ms ease, box-shadow 120ms ease;
    }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.08);
    }
    .thumb {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      overflow: hidden;
      background: linear-gradient(135deg, #c3d9ff, #e8f0ff);
    }
    .thumb img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .meta { padding: 12px 14px 14px; }
    .title { font-weight: 600; margin: 0 0 6px; line-height: 1.3; }
    .id { color: #666; font-size: 12px; word-break: break-all; }
    .empty { color: #555; }
  </style>
</head>
<body>
  <div class="topbar">
    <h1 style="margin: 0;">HLS Tube</h1>
    <a href="/upload" style="font-weight: 600; color: #3943d0;">Upload</a>
  </div>

  {% if videos | length == 0 %}
    <p class="empty">No videos yet.</p>
  {% else %}
    <div class="grid">
      {% for v in videos %}
        <a class="card" href="/watch/{{ v.id }}">
          <div class="thumb">
            {% if v.thumbnail %}
              <img src="{{ v.thumbnail }}" alt="{{ v.title }}" loading="lazy" />
            {% endif %}
          </div>
          <div class="meta">
            <p class="title">{{ v.title }}</p>
            <div class="id">{{ v.id }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</body>
</html>
