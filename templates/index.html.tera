<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>HLS Tube</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #fafafa;
      --text: #1f1f1f;
      --muted: #555;
      --card: #ffffff;
      --shadow: rgba(0,0,0,0.06);
      --shadow-hover: rgba(0,0,0,0.1);
      --thumb-1: #c3d9ff;
      --thumb-2: #e8f0ff;
      --link: #3943d0;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f1116;
        --text: #f1f2f4;
        --muted: #a7adba;
        --card: #1b1f2a;
        --shadow: rgba(0,0,0,0.35);
        --shadow-hover: rgba(0,0,0,0.45);
        --thumb-1: #1e2a44;
        --thumb-2: #2c394f;
        --link: #8ea2ff;
      }
    }
    body { font-family: "IBM Plex Sans", "Segoe UI", "Helvetica Neue", Arial, sans-serif; max-width: 1080px; margin: 24px auto; padding: 0 12px; background: var(--bg); color: var(--text); }
    a { text-decoration: none; color: inherit; }
    .accent { color: var(--link); }
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
      align-items: start;
    }
    .section { margin-top: 18px; }
    .section-title { display: flex; align-items: baseline; gap: 8px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); margin: 0 0 10px; }
    .count-pill { font-size: 12px; padding: 2px 8px; border-radius: 999px; background: rgba(0,0,0,0.08); color: var(--muted); }
    @media (prefers-color-scheme: dark) {
      .count-pill { background: rgba(255,255,255,0.1); }
    }
    .card {
      background: var(--card);
      border-radius: 12px;
      box-shadow: 0 8px 22px var(--shadow);
      overflow: hidden;
      transition: transform 120ms ease, box-shadow 120ms ease;
    }
    .card.processing { border: 1px solid rgba(57, 67, 208, 0.35); }
    .card.error { border: 1px solid rgba(220, 90, 90, 0.45); }
    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px var(--shadow-hover);
    }
    .thumb {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      overflow: hidden;
      background: linear-gradient(135deg, var(--thumb-1), var(--thumb-2));
    }
    .thumb img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .meta { padding: 12px 14px 14px; }
    .title { font-weight: 600; margin: 0 0 6px; line-height: 1.3; }
    .id { color: var(--muted); font-size: 12px; word-break: break-all; }
    .meta-line { color: var(--muted); font-size: 13px; display: flex; gap: 8px; flex-wrap: wrap; }
    .status-line { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--muted); margin-top: 8px; }
    .status-badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
    .status-processing { background: rgba(57, 67, 208, 0.12); color: var(--link); }
    .status-error { background: rgba(220, 90, 90, 0.14); color: #c74848; }
    @media (prefers-color-scheme: dark) {
      .status-error { color: #ff9b9b; }
    }
    .progress-bar { margin-top: 8px; background: rgba(0,0,0,0.08); border-radius: 999px; height: 8px; overflow: hidden; position: relative; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, #3943d0, #6f7bff); width: 0%; transition: width 240ms ease; }
    .progress-bar.unknown::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(57,67,208,0.2), rgba(57,67,208,0.2) 8px, rgba(57,67,208,0.05) 8px, rgba(57,67,208,0.05) 16px); animation: shimmer 1.4s linear infinite; }
    @keyframes shimmer { from { background-position: 0 0; } to { background-position: 32px 0; } }
    .error-text { color: var(--muted); font-size: 12px; margin-top: 6px; line-height: 1.4; }
    .empty { color: var(--muted); }
    .empty-card { margin-top: 16px; padding: 18px; background: var(--card); border-radius: 12px; box-shadow: 0 8px 22px var(--shadow); }
    .empty-card a { color: var(--link); font-weight: 600; }
  </style>
</head>
<body>
  <div class="topbar">
    <h1 style="margin: 0;">HLS Tube</h1>
    <a href="/upload" class="accent" style="font-weight: 600;">Upload</a>
  </div>

  {% set total_videos = processing_videos | length + ready_videos | length + error_videos | length %}
  {% if total_videos == 0 %}
    <div class="empty-card">
      <p class="empty">No videos yet. Upload one to get started.</p>
      <a href="/upload">Upload a video</a>
    </div>
  {% else %}
    {% if processing_videos | length > 0 %}
      <section class="section">
        <h2 class="section-title">Processing <span class="count-pill">{{ processing_videos | length }}</span></h2>
        <div class="grid">
          {% for v in processing_videos %}
            <a class="card processing" href="/watch/{{ v.id }}" data-created-at="{{ v.created_at }}" data-duration="{{ v.duration_seconds | default(value=0) }}" data-status="{{ v.status }}" data-progress="{{ v.progress | default(value="") }}">
              <div class="thumb">
                {% if v.thumbnail %}
                  <img src="{{ v.thumbnail }}" alt="{{ v.title }}" loading="lazy" />
                {% endif %}
              </div>
              <div class="meta">
                <p class="title">{{ v.title }}</p>
                <div class="meta-line">
                  {% if v.width and v.height %}
                    <span>{{ v.width }}×{{ v.height }}</span>
                  {% endif %}
                  <span class="duration">--:--</span>
                  <span class="created">--</span>
                </div>
                <div class="status-line">
                  <span class="status-badge status-processing">Processing</span>
                  <span class="progress-text">Preparing...</span>
                </div>
                <div class="progress-bar unknown" role="progressbar" aria-valuemin="0" aria-valuemax="100">
                  <div class="progress-fill"></div>
                </div>
                <div class="id">{{ v.id }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if ready_videos | length > 0 %}
      <section class="section">
        <h2 class="section-title">Ready <span class="count-pill">{{ ready_videos | length }}</span></h2>
        <div class="grid">
          {% for v in ready_videos %}
            <a class="card" href="/watch/{{ v.id }}" data-created-at="{{ v.created_at }}" data-duration="{{ v.duration_seconds | default(value=0) }}">
              <div class="thumb">
                {% if v.thumbnail %}
                  <img src="{{ v.thumbnail }}" alt="{{ v.title }}" loading="lazy" />
                {% endif %}
              </div>
              <div class="meta">
                <p class="title">{{ v.title }}</p>
                <div class="meta-line">
                  {% if v.width and v.height %}
                    <span>{{ v.width }}×{{ v.height }}</span>
                  {% endif %}
                  <span class="duration">--:--</span>
                  <span class="created">--</span>
                </div>
                <div class="id">{{ v.id }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if error_videos | length > 0 %}
      <section class="section">
        <h2 class="section-title">Needs Attention <span class="count-pill">{{ error_videos | length }}</span></h2>
        <div class="grid">
          {% for v in error_videos %}
            <a class="card error" href="/watch/{{ v.id }}" data-created-at="{{ v.created_at }}" data-duration="{{ v.duration_seconds | default(value=0) }}">
              <div class="thumb">
                {% if v.thumbnail %}
                  <img src="{{ v.thumbnail }}" alt="{{ v.title }}" loading="lazy" />
                {% endif %}
              </div>
              <div class="meta">
                <p class="title">{{ v.title }}</p>
                <div class="meta-line">
                  {% if v.width and v.height %}
                    <span>{{ v.width }}×{{ v.height }}</span>
                  {% endif %}
                  <span class="duration">--:--</span>
                  <span class="created">--</span>
                </div>
                <div class="status-line">
                  <span class="status-badge status-error">Failed</span>
                </div>
                {% if v.error %}
                  <div class="error-text">{{ v.error }}</div>
                {% endif %}
                <div class="id">{{ v.id }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% endif %}

  <script>
    const cards = Array.from(document.querySelectorAll('.card'));
    const fmtDuration = (sec) => {
      if (!sec || sec <= 0) return '--:--';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    };
    const fmtDate = (ts) => {
      if (!ts) return '--';
      const d = new Date(ts * 1000);
      return d.toLocaleDateString();
    };
    cards.forEach((card) => {
      const duration = Number(card.dataset.duration || 0);
      const createdAt = Number(card.dataset.createdAt || 0);
      const durationEl = card.querySelector('.duration');
      const createdEl = card.querySelector('.created');
      if (durationEl) durationEl.textContent = fmtDuration(duration);
      if (createdEl) createdEl.textContent = fmtDate(createdAt);

      const status = card.dataset.status;
      if (status === 'processing') {
        const progressRaw = card.dataset.progress;
        const hasProgress = progressRaw !== '';
        const progress = Number(progressRaw || 0);
        const progressText = card.querySelector('.progress-text');
        const progressFill = card.querySelector('.progress-fill');
        const progressBar = card.querySelector('.progress-bar');
        if (progressBar) {
          if (hasProgress && Number.isFinite(progress)) {
            const pct = Math.max(0, Math.min(99, Math.round(progress)));
            progressBar.classList.remove('unknown');
            if (progressFill) progressFill.style.width = `${pct}%`;
            if (progressText) progressText.textContent = `${pct}% done • ${100 - pct}% left`;
            progressBar.setAttribute('aria-valuenow', `${pct}`);
          } else {
            if (progressText) progressText.textContent = 'Queued • estimating...';
            progressBar.setAttribute('aria-valuenow', '0');
          }
        }
      }
    });
  </script>
</body>
</html>
