<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Upload</title>
  <style>
    :root { color-scheme: light; }
    body { font-family: system-ui, sans-serif; max-width: 900px; margin: 24px auto; padding: 0 12px; }
    .drop {
      margin-top: 16px;
      border: 2px dashed #6c7ae0;
      border-radius: 10px;
      padding: 28px;
      text-align: center;
      background: #f7f7ff;
      transition: background 120ms ease, border-color 120ms ease;
      cursor: pointer;
    }
    .drop.dragover {
      border-color: #3943d0;
      background: #eef0ff;
    }
    .hint { color: #555; margin-top: 12px; }
    #status { margin-top: 12px; color: #3943d0; }
    #error { margin-top: 12px; color: #c62828; }
    input[type="text"] { width: 100%; max-width: 420px; padding: 8px; font-size: 16px; }
    .field { margin-top: 12px; }
    .queue { margin-top: 8px; }
    .queue-item { display: flex; gap: 12px; align-items: center; margin-top: 8px; }
    .queue-name { font-size: 14px; color: #333; min-width: 160px; }
    .queue-item input { flex: 1; }
    button { margin-top: 16px; padding: 10px 16px; font-size: 15px; }
  </style>
</head>
<body>
  <h1>Upload</h1>
  <p><a href="/">Back</a></p>

  <div class="field">
    <label>Titles (optional)</label><br/>
    <div id="queue" class="queue hint">Add files to set titles.</div>
  </div>

  <div id="drop" class="drop">
    <strong>Drag & drop videos</strong><br/>
    <span class="hint">…or click to pick one or more files. Upload starts immediately.</span>
  </div>

  <input id="file" name="video" type="file" accept="video/mp4,video/*" multiple style="display:none" />

  <div id="status"></div>
  <div id="error"></div>
  <ul id="results" class="hint" style="padding-left: 18px;"></ul>

  <button id="uploadBtn" type="button" disabled>Start upload</button>

  <p class="hint">
    Upload triggers FFmpeg packaging to HLS in the background. Large files will take time; you can refresh the watch page until it’s ready.
  </p>

  <script>
    const drop = document.getElementById('drop');
    const fileInput = document.getElementById('file');
    const queueEl = document.getElementById('queue');
    const statusEl = document.getElementById('status');
    const errorEl = document.getElementById('error');
    const resultsEl = document.getElementById('results');
    const uploadBtn = document.getElementById('uploadBtn');

    const setStatus = (msg) => { statusEl.textContent = msg || ''; };
    const setError = (msg) => { errorEl.textContent = msg || ''; };

    drop.addEventListener('click', () => fileInput.click());

    ['dragenter','dragover'].forEach(evt =>
      drop.addEventListener(evt, e => { e.preventDefault(); e.stopPropagation(); drop.classList.add('dragover'); })
    );
    ['dragleave','drop'].forEach(evt =>
      drop.addEventListener(evt, e => { e.preventDefault(); e.stopPropagation(); drop.classList.remove('dragover'); })
    );

    drop.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      if (files?.length) addFiles(files);
    });

    fileInput.addEventListener('change', () => {
      const files = fileInput.files;
      if (files?.length) addFiles(files);
      fileInput.value = '';
    });

    let uploading = false;
    const files = [];

    function addFiles(fileList) {
      for (const file of Array.from(fileList)) {
        files.push(file);
      }
      renderQueue();
    }

    function renderQueue() {
      queueEl.textContent = '';
      if (!files.length) {
        queueEl.textContent = 'Add files to set titles.';
        uploadBtn.disabled = true;
        return;
      }
      files.forEach((file, idx) => {
        const row = document.createElement('div');
        row.className = 'queue-item';

        const name = document.createElement('div');
        name.className = 'queue-name';
        name.textContent = file.name;

        const input = document.createElement('input');
        input.type = 'text';
        input.placeholder = 'Optional title';
        input.dataset.idx = String(idx);

        row.appendChild(name);
        row.appendChild(input);
        queueEl.appendChild(row);
      });
      uploadBtn.disabled = false;
    }

    function setBusy(busy) {
      drop.textContent = busy ? 'Uploading…' : 'Drag & drop videos';
      drop.style.pointerEvents = busy ? 'none' : 'auto';
      fileInput.disabled = busy;
      uploadBtn.disabled = busy;
      queueEl.querySelectorAll('input').forEach((input) => {
        input.disabled = busy;
      });
    }

    async function startUpload() {
      if (!files.length || uploading) return;
      uploading = true;
      setError('');
      setStatus(`Uploading ${files.length} file${files.length === 1 ? '' : 's'}…`);
      resultsEl.textContent = '';
      setBusy(true);

      const titles = Array.from(queueEl.querySelectorAll('input[data-idx]'))
        .map(input => input.value.trim());

      const form = new FormData();
      files.forEach((file, idx) => {
        form.append('video', file);
        form.append('title', titles[idx] || '');
      });

      try {
        const resp = await fetch('/upload', { method: 'POST', body: form });
        if (!resp.ok) {
          const text = await resp.text();
          throw new Error(text || `Upload failed (${resp.status})`);
        }
        const payload = await resp.json();
        const items = payload?.items || [];
        if (!items.length) throw new Error('Upload finished with no results.');

        if (items.length === 1 && items[0].watch_url) {
          window.location.href = items[0].watch_url;
          return;
        }

        items.forEach((item, idx) => {
          const row = document.createElement('li');
          const link = document.createElement('a');
          link.href = item.watch_url || '/';
          link.textContent = item.title || files[idx]?.name || 'View upload';
          row.appendChild(link);
          resultsEl.appendChild(row);
        });
        setStatus('All uploads finished.');
        files.length = 0;
        renderQueue();
      } catch (err) {
        setStatus('');
        setError(err.message || 'Upload failed.');
      } finally {
        uploading = false;
        setBusy(false);
      }
    }

    uploadBtn.addEventListener('click', startUpload);
  </script>
</body>
</html>
