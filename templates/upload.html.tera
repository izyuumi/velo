<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Upload</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #fafafa;
      --text: #1f1f1f;
      --muted: #666;
      --card: #fff;
      --border: #ddd;
      --link: #1a1a1a;
      --error: #c74848;
      --input-bg: #fff;
      --input-border: #ccc;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #111;
        --text: #f1f2f4;
        --muted: #888;
        --card: #1a1a1a;
        --border: #333;
        --link: #fff;
        --error: #ff8a80;
        --input-bg: #1a1a1a;
        --input-border: #444;
      }
    }
    body { font-family: "IBM Plex Sans", "Segoe UI", "Helvetica Neue", Arial, sans-serif; max-width: 900px; margin: 24px auto; padding: 0 12px; background: var(--bg); color: var(--text); }
    a { color: var(--link); }
    .drop {
      margin-top: 16px;
      border: 1px dashed var(--border);
      border-radius: 6px;
      padding: 28px;
      text-align: center;
      background: var(--card);
      cursor: pointer;
    }
    .drop.dragover {
      border-color: var(--text);
    }
    .hint { color: var(--muted); margin-top: 12px; }
    #status { margin-top: 12px; color: var(--link); }
    #error { margin-top: 12px; color: var(--error); }
    input[type="text"] {
      width: 100%;
      max-width: 420px;
      padding: 8px;
      font-size: 14px;
      background: var(--input-bg);
      color: var(--text);
      border: 1px solid var(--input-border);
      border-radius: 4px;
    }
    .field { margin-top: 12px; }
    .queue { margin-top: 8px; }
    .queue-item { display: grid; grid-template-columns: 160px 1fr; gap: 8px 12px; align-items: center; margin-top: 12px; }
    .queue-name { font-size: 14px; color: var(--text); min-width: 160px; word-break: break-word; }
    .queue-item input { width: 100%; }
    .queue-status { grid-column: 1 / -1; font-size: 13px; color: var(--muted); display: flex; gap: 12px; }
    .progress {
      grid-column: 1 / -1;
      height: 4px;
      background: var(--border);
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--text);
      transition: width 120ms ease;
    }
    .progress.processing .progress-fill {
      background: var(--muted);
    }
    button {
      margin-top: 16px;
      padding: 10px 16px;
      font-size: 14px;
      background: var(--link);
      color: var(--bg);
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  </style>
</head>
<body>
  <h1>Upload</h1>
  <p><a href="/">Back</a></p>

  <div class="field">
    <label>Titles (optional)</label><br/>
    <div id="queue" class="queue hint">Add files to set titles.</div>
  </div>

  <div id="drop" class="drop">
    <strong>Drag & drop videos</strong><br/>
    <span class="hint">…or click to pick one or more files. Upload starts immediately.</span>
  </div>

  <input id="file" name="video" type="file" accept="video/mp4,video/*" multiple style="display:none" />

  <div id="status"></div>
  <div id="error"></div>
  <ul id="results" class="hint" style="padding-left: 18px;"></ul>

  <button id="uploadBtn" type="button" disabled>Start upload</button>

  <script>
    const drop = document.getElementById('drop');
    const fileInput = document.getElementById('file');
    const queueEl = document.getElementById('queue');
    const statusEl = document.getElementById('status');
    const errorEl = document.getElementById('error');
    const resultsEl = document.getElementById('results');
    const uploadBtn = document.getElementById('uploadBtn');

    const setStatus = (msg) => { statusEl.textContent = msg || ''; };
    const setError = (msg) => { errorEl.textContent = msg || ''; };

    drop.addEventListener('click', () => fileInput.click());

    ['dragenter','dragover'].forEach(evt =>
      drop.addEventListener(evt, e => { e.preventDefault(); e.stopPropagation(); drop.classList.add('dragover'); })
    );
    ['dragleave','drop'].forEach(evt =>
      drop.addEventListener(evt, e => { e.preventDefault(); e.stopPropagation(); drop.classList.remove('dragover'); })
    );

    drop.addEventListener('drop', (e) => {
      const files = e.dataTransfer.files;
      if (files?.length) {
        addFiles(files);
        startUpload();
      }
    });

    fileInput.addEventListener('change', () => {
      const files = fileInput.files;
      if (files?.length) {
        addFiles(files);
        startUpload();
      }
      fileInput.value = '';
    });

    let uploading = false;
    const queue = [];

    function addFiles(fileList) {
      for (const file of Array.from(fileList)) {
        queue.push({ file });
      }
      renderQueue();
    }

    function renderQueue() {
      queueEl.textContent = '';
      if (!queue.length) {
        queueEl.textContent = 'Add files to set titles.';
        uploadBtn.disabled = true;
        return;
      }
      queue.forEach((item, idx) => {
        const row = document.createElement('div');
        row.className = 'queue-item';

        const name = document.createElement('div');
        name.className = 'queue-name';
        name.textContent = item.file.name;

        const input = document.createElement('input');
        input.type = 'text';
        input.placeholder = 'Optional title';
        input.dataset.idx = String(idx);
        input.value = item.file.name;

        const status = document.createElement('div');
        status.className = 'queue-status';
        status.textContent = 'Queued';

        const uploadBar = document.createElement('div');
        uploadBar.className = 'progress';
        const uploadFill = document.createElement('div');
        uploadFill.className = 'progress-fill';
        uploadBar.appendChild(uploadFill);

        const processingBar = document.createElement('div');
        processingBar.className = 'progress processing';
        const processingFill = document.createElement('div');
        processingFill.className = 'progress-fill';
        processingBar.appendChild(processingFill);

        row.appendChild(name);
        row.appendChild(input);
        row.appendChild(status);
        row.appendChild(uploadBar);
        row.appendChild(processingBar);
        queueEl.appendChild(row);

        item.input = input;
        item.status = status;
        item.uploadFill = uploadFill;
        item.processingFill = processingFill;
      });
      uploadBtn.disabled = false;
    }

    function setBusy(busy) {
      drop.textContent = busy ? 'Uploading…' : 'Drag & drop videos';
      drop.style.pointerEvents = busy ? 'none' : 'auto';
      fileInput.disabled = busy;
      uploadBtn.disabled = busy;
      queueEl.querySelectorAll('input').forEach((input) => {
        input.disabled = busy;
      });
    }

    async function readErrorMessage(resp) {
      try {
        if (resp && typeof resp.json === 'function') {
          const data = await resp.json();
          if (data && data.message) return data.message;
          const text = await resp.text();
          return text || `Upload failed (${resp.status})`;
        }
        if (resp && resp.responseText) {
          const data = JSON.parse(resp.responseText);
          if (data && data.message) return data.message;
          return resp.responseText || `Upload failed (${resp.status})`;
        }
      } catch (err) {
        // Ignore JSON parsing errors and fall back to text.
      }
      return `Upload failed (${resp.status || 'unknown'})`;
    }

    async function startUpload() {
      if (!queue.length || uploading) return;
      uploading = true;
      setError('');
      setStatus(`Uploading ${queue.length} file${queue.length === 1 ? '' : 's'}…`);
      resultsEl.textContent = '';
      setBusy(true);

      try {
        for (let idx = 0; idx < queue.length; idx += 1) {
          const item = queue[idx];
          const title = item.input.value.trim() || item.file.name;
          await uploadSingle(item, title);
        }
        setStatus('All uploads finished.');
        queue.length = 0;
        renderQueue();
      } catch (err) {
        setStatus('');
        setError(err && err.message ? err.message : 'Upload failed. Please try again.');
      } finally {
        uploading = false;
        setBusy(false);
      }
    }

    async function uploadSingle(item, title) {
      item.status.textContent = 'Uploading…';
      item.uploadFill.style.width = '0%';
      item.processingFill.style.width = '0%';

      const form = new FormData();
      form.append('video', item.file);
      form.append('title', title);

      const resp = await new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/upload');
        xhr.upload.addEventListener('progress', (evt) => {
          if (evt.lengthComputable) {
            const pct = Math.round((evt.loaded / evt.total) * 100);
            item.uploadFill.style.width = `${pct}%`;
          }
        });
        xhr.onload = () => resolve(xhr);
        xhr.onerror = () => reject(new Error('Upload failed.'));
        xhr.send(form);
      });

      if (resp.status < 200 || resp.status >= 300) {
        const message = await readErrorMessage(resp);
        throw new Error(message);
      }

      const data = JSON.parse(resp.responseText);
      item.status.textContent = 'Processing…';
      pollStatus(item, data.id);

      const row = document.createElement('li');
      const link = document.createElement('a');
      link.href = data.watch_url || '/';
      link.textContent = data.title || item.file.name || 'View upload';
      row.appendChild(link);
      resultsEl.appendChild(row);
    }

    async function pollStatus(item, id) {
      const maxAttempts = 120;
      for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
        const resp = await fetch(`/api/status/${id}`);
        if (resp.ok) {
          const status = await resp.json();
          if (status.status === 'ready') {
            item.status.textContent = 'Ready';
            item.processingFill.style.width = '100%';
            return;
          }
          if (status.status === 'error') {
            item.status.textContent = `Error: ${status.error || 'Processing failed'}`;
            return;
          }
          if (typeof status.progress === 'number') {
            const pct = Math.max(0, Math.min(99, Math.round(status.progress)));
            item.processingFill.style.width = `${pct}%`;
          }
        }
        await new Promise((resolve) => setTimeout(resolve, 1500));
      }
      item.status.textContent = 'Still processing. Check the watch page.';
    }

    uploadBtn.addEventListener('click', startUpload);
  </script>
</body>
</html>
