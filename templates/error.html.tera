<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    :root { color-scheme: light; }
    body { font-family: system-ui, sans-serif; max-width: 760px; margin: 48px auto; padding: 0 16px; background: #f8f9fb; }
    .card { background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 10px 28px rgba(0,0,0,0.08); }
    .code { font-size: 14px; color: #666; letter-spacing: 0.08em; text-transform: uppercase; }
    h1 { margin: 8px 0 12px; }
    p { margin: 0 0 16px; color: #444; }
    a { color: #3943d0; font-weight: 600; text-decoration: none; }
  </style>
</head>
<body>
  <div class="card">
    <div class="code">Error {{ code }}</div>
    <h1>{{ title }}</h1>
    <p>{{ message }}</p>
    <a href="/">Back to home</a>
  </div>
</body>
</html>
