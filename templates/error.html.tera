<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f8f9fb;
      --text: #1f1f1f;
      --muted: #666;
      --card: #ffffff;
      --shadow: rgba(0,0,0,0.08);
      --link: #3943d0;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f1116;
        --text: #f1f2f4;
        --muted: #a7adba;
        --card: #1b1f2a;
        --shadow: rgba(0,0,0,0.35);
        --link: #8ea2ff;
      }
    }
    body { font-family: "IBM Plex Sans", "Segoe UI", "Helvetica Neue", Arial, sans-serif; max-width: 760px; margin: 48px auto; padding: 0 16px; background: var(--bg); color: var(--text); }
    .card { background: var(--card); border-radius: 12px; padding: 24px; box-shadow: 0 10px 28px var(--shadow); }
    .code { font-size: 14px; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; }
    h1 { margin: 8px 0 12px; }
    p { margin: 0 0 16px; color: var(--text); }
    a { color: var(--link); font-weight: 600; text-decoration: none; }
  </style>
</head>
<body>
  <div class="card">
    <div class="code">Error {{ code }}</div>
    <h1>{{ title }}</h1>
    <p>{{ message }}</p>
    <a href="/">Back to home</a>
  </div>
</body>
</html>
