<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Watch</title>
  <script src="/static/vendor/hls.min.js"></script>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f9fafc;
      --text: #1f1f1f;
      --link: #3943d0;
      --notice-error-bg: #ffe8e8;
      --notice-error-text: #8a1f1f;
      --notice-info-bg: #eef3ff;
      --notice-info-text: #1f3d8a;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f1116;
        --text: #f1f2f4;
        --link: #8ea2ff;
        --notice-error-bg: #3b1a1c;
        --notice-error-text: #ffb4b4;
        --notice-info-bg: #1a2236;
        --notice-info-text: #b9c7ff;
      }
    }
    body { font-family: "IBM Plex Sans", "Segoe UI", "Helvetica Neue", Arial, sans-serif; max-width: 900px; margin: 24px auto; padding: 0 12px; background: var(--bg); color: var(--text); }
    a { color: var(--link); }
    .notice { padding: 10px 12px; border-radius: 8px; margin: 12px 0; }
    .notice.error { background: var(--notice-error-bg); color: var(--notice-error-text); }
    .notice.info { background: var(--notice-info-bg); color: var(--notice-info-text); }
  </style>
</head>
<body>
  <p><a href="/">Back</a></p>
  <h1>Watch</h1>

  {% if ctx.error %}
    <p class="notice error">Processing failed: {{ ctx.error }}</p>
  {% elif ctx.ready %}
    <p id="playerStatus" class="notice info" style="display:none;"></p>
    <video id="video" controls style="width: 100%; max-height: 70vh;"></video>
    <script>
      const video = document.getElementById('video');
      const statusEl = document.getElementById('playerStatus');
      const src = `/hls/{{ ctx.id }}/master.m3u8`;

      window.addEventListener('unhandledrejection', (event) => {
        if (event.reason && event.reason.name === 'AbortError') {
          event.preventDefault();
        }
      });

      function setPlayerStatus(msg) {
        if (!statusEl) return;
        statusEl.textContent = msg || '';
        statusEl.style.display = msg ? 'block' : 'none';
      }

      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = src;
      } else if (Hls.isSupported()) {
        const hls = new Hls();
        hls.loadSource(src);
        hls.attachMedia(video);
        hls.on(Hls.Events.ERROR, function (_event, data) {
          if (data && data.fatal) {
            setPlayerStatus('Playback failed. Try refreshing or re-uploading the video.');
          }
        });
      } else {
        video.outerHTML = "<p class=\"notice error\">Your browser can't play HLS. Try Safari or a modern Chrome/Firefox.</p>";
      }

      video.addEventListener('error', () => {
        setPlayerStatus('We hit a playback error. Refresh the page or try again later.');
      });
    </script>
  {% else %}
    <p class="notice info">Processing… refresh in a moment. If this takes too long, check your upload size and format.</p>
  {% endif %}
</body>
</html>
