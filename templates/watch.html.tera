<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Watch</title>
  <script src="/static/vendor/hls.min.js"></script>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #fafafa;
      --text: #1f1f1f;
      --muted: #666;
      --link: #1a1a1a;
      --border: #ddd;
      --error: #c74848;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #111;
        --text: #f1f2f4;
        --muted: #888;
        --link: #fff;
        --border: #333;
        --error: #ff8a80;
      }
    }
    body { font-family: "IBM Plex Sans", "Segoe UI", "Helvetica Neue", Arial, sans-serif; max-width: 900px; margin: 24px auto; padding: 0 12px; background: var(--bg); color: var(--text); }
    a { color: var(--link); }
    .notice { padding: 10px 0; margin: 12px 0; font-size: 14px; }
    .notice.error { color: var(--error); }
    .notice.info { color: var(--muted); }
    .meta { color: var(--text); margin: 8px 0 16px; display: flex; gap: 12px; flex-wrap: wrap; font-size: 14px; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
    .actions button,
    .edit-panel button {
      padding: 8px 12px;
      border-radius: 4px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text);
      cursor: pointer;
      font-size: 13px;
    }
    .actions button.secondary,
    .edit-panel button.secondary {
      background: transparent;
      color: var(--muted);
    }
    .edit-panel {
      display: none;
      gap: 8px;
      flex-wrap: wrap;
      margin: 12px 0;
    }
    .edit-panel input {
      padding: 8px 10px;
      font-size: 14px;
      border-radius: 4px;
      border: 1px solid var(--border);
      min-width: 220px;
      background: transparent;
      color: inherit;
    }
    .progress {
      height: 4px;
      background: var(--border);
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--text);
      transition: width 120ms ease;
    }
  </style>
</head>
<body data-ready="{{ ctx.ready }}">
  <p><a href="/">Back</a></p>
  <h1 id="title">{{ ctx.title }}</h1>
  <div class="meta">
    {% if ctx.width and ctx.height %}
      <span>{{ ctx.width }}×{{ ctx.height }}</span>
    {% endif %}
    <span id="duration" data-duration="{{ ctx.duration_seconds | default(value=0) }}">--:--</span>
    <span id="created" data-created="{{ ctx.created_at }}">--</span>
  </div>

  <div class="actions">
    <button id="editToggle" type="button" class="secondary">Edit</button>
  </div>
  <div id="editPanel" class="edit-panel">
    <input id="renameInput" type="text" value="{{ ctx.title }}" />
    <button id="renameBtn" type="button">Save</button>
    <button id="cancelEdit" type="button" class="secondary">Cancel</button>
    <button id="deleteBtn" type="button" class="secondary">Delete</button>
  </div>

  <p id="processingNotice" class="notice info" style="display:none;">Processing…</p>
  <div id="processingProgress" class="progress" style="display:none;"><div class="progress-fill" id="processingFill"></div></div>
  <p id="errorNotice" class="notice error" style="display:{% if ctx.error %}block{% else %}none{% endif %};">
    {% if ctx.error %}Processing failed: {{ ctx.error }}{% endif %}
  </p>
  <p id="playerStatus" class="notice info" style="display:none;"></p>
  <video id="video" controls style="width: 100%; max-height: 70vh; display:none;"></video>

  <script>
    const video = document.getElementById('video');
    const statusEl = document.getElementById('playerStatus');
    const processingNotice = document.getElementById('processingNotice');
    const errorNotice = document.getElementById('errorNotice');
    const processingFill = document.getElementById('processingFill');
    const processingProgress = document.getElementById('processingProgress');
    const renameInput = document.getElementById('renameInput');
    const renameBtn = document.getElementById('renameBtn');
    const deleteBtn = document.getElementById('deleteBtn');
    const editToggle = document.getElementById('editToggle');
    const editPanel = document.getElementById('editPanel');
    const cancelEdit = document.getElementById('cancelEdit');
    const titleEl = document.getElementById('title');
    const durationEl = document.getElementById('duration');
    const createdEl = document.getElementById('created');
    const src = `/hls/{{ ctx.id }}/master.m3u8`;

    const fmtDuration = (sec) => {
      if (!sec || sec <= 0) return '--:--';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    };
    const fmtDate = (ts) => {
      if (!ts) return '--';
      const d = new Date(ts * 1000);
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      const h = String(d.getHours()).padStart(2, '0');
      const min = String(d.getMinutes()).padStart(2, '0');
      return `${y}/${m}/${day} ${h}:${min}`;
    };
    durationEl.textContent = fmtDuration(Number(durationEl.dataset.duration || 0));
    createdEl.textContent = fmtDate(Number(createdEl.dataset.created || 0));

    window.addEventListener('unhandledrejection', (event) => {
      if (event.reason && event.reason.name === 'AbortError') {
        event.preventDefault();
      }
    });

    function setPlayerStatus(msg) {
      statusEl.textContent = msg || '';
      statusEl.style.display = msg ? 'block' : 'none';
    }

    function loadPlayer() {
      if (video.dataset.loaded) return;
      video.dataset.loaded = '1';
      video.style.display = 'block';
      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = src;
      } else if (Hls.isSupported()) {
        const hls = new Hls();
        hls.loadSource(src);
        hls.attachMedia(video);
        hls.on(Hls.Events.ERROR, function (_event, data) {
          if (data && data.fatal) {
            setPlayerStatus('Playback failed. Try refreshing or re-uploading the video.');
          }
        });
      } else {
        video.outerHTML = "<p class=\"notice error\">Your browser doesn't support video playback. Try a different browser.</p>";
      }
      video.addEventListener('error', () => {
        setPlayerStatus('We hit a playback error. Refresh the page or try again later.');
      });
    }

    async function pollStatus() {
      const resp = await fetch(`/api/status/{{ ctx.id }}`);
      if (!resp.ok) return;
      const status = await resp.json();
      titleEl.textContent = status.title || titleEl.textContent;
      renameInput.value = status.title || renameInput.value;
      durationEl.textContent = fmtDuration(status.duration_seconds || 0);
      createdEl.textContent = fmtDate(status.created_at || 0);

      if (status.status === 'ready') {
        processingNotice.style.display = 'none';
        processingProgress.style.display = 'none';
        errorNotice.style.display = 'none';
        loadPlayer();
        return true;
      }

      if (status.status === 'error') {
        processingNotice.style.display = 'none';
        processingProgress.style.display = 'none';
        errorNotice.textContent = `Processing failed: ${status.error || 'Unknown error'}`;
        errorNotice.style.display = 'block';
        return false;
      }

      processingNotice.style.display = 'block';
      processingProgress.style.display = 'block';
      const pct = typeof status.progress === 'number' ? Math.min(99, Math.max(0, Math.round(status.progress))) : 0;
      processingFill.style.width = `${pct}%`;
      return false;
    }

    async function pollLoop() {
      let ready = document.body.dataset.ready === 'true';
      if (ready) {
        loadPlayer();
        return;
      }
      for (let i = 0; i < 200; i += 1) {
        const done = await pollStatus();
        if (done) return;
        await new Promise((resolve) => setTimeout(resolve, 2000));
      }
      processingNotice.textContent = 'Still processing… try refreshing later.';
    }

    renameBtn.addEventListener('click', async () => {
      const title = renameInput.value.trim();
      if (!title) return;
      const resp = await fetch(`/api/video/{{ ctx.id }}/rename`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title })
      });
      if (!resp.ok) {
        const data = await resp.json().catch(() => ({}));
        setPlayerStatus(data.message || 'Rename failed.');
        return;
      }
      const data = await resp.json();
      titleEl.textContent = data.title;
    });

    editToggle.addEventListener('click', () => {
      editPanel.style.display = editPanel.style.display === 'flex' ? 'none' : 'flex';
    });

    cancelEdit.addEventListener('click', () => {
      renameInput.value = titleEl.textContent;
      editPanel.style.display = 'none';
    });

    deleteBtn.addEventListener('click', async () => {
      const confirmDelete = window.confirm('Delete this video? This cannot be undone.');
      if (!confirmDelete) return;
      const resp = await fetch(`/api/video/{{ ctx.id }}`, { method: 'DELETE' });
      if (resp.ok) {
        window.location.href = '/';
      }
    });

    pollLoop();
  </script>
</body>
</html>
